{
   "version": "0.2.0",
   "configurations": [
      {
         "name": "Debug NestJS",
         "type": "node",
         "request": "launch",
         "runtimeArgs": [
            "--nolazy",
            "-r",
            "ts-node/register",
            "-r",
            "tsconfig-paths/register"
         ],
         "args": [
            "${workspaceFolder}/src/main.ts"
         ],
         "sourceMaps": true,
         "cwd": "${workspaceFolder}",
         "protocol": "inspector",
         "console": "integratedTerminal",
         "env": {
            "NODE_ENV": "development"
         }
      },
      {
         "name": "Debug NestJS (npm start:debug)",
         "type": "node",
         "request": "launch",
         "runtimeExecutable": "npm",
         "runtimeArgs": [
            "run",
            "start:debug"
         ],
         "sourceMaps": true,
         "cwd": "${workspaceFolder}",
         "console": "integratedTerminal",
         "restart": true,
         "env": {
            "NODE_ENV": "development"
         }
      },
      {
         "name": "Attach to NestJS",
         "type": "node",
         "request": "attach",
         "port": 9229,
         "sourceMaps": true,
         "restart": true,
         "cwd": "${workspaceFolder}"
      },
      {
         "name": "Debug NestJS Tests",
         "type": "node",
         "request": "launch",
         "runtimeExecutable": "npm",
         "runtimeArgs": [
            "run",
            "test:debug"
         ],
         "sourceMaps": true,
         "cwd": "${workspaceFolder}",
         "console": "integratedTerminal"
      },
      {
         "name": "Debug NestJS E2E Tests",
         "type": "node",
         "request": "launch",
         "runtimeExecutable": "npm",
         "runtimeArgs": [
            "run",
            "test:e2e",
            "--",
            "--runInBand"
         ],
         "sourceMaps": true,
         "cwd": "${workspaceFolder}",
         "console": "integratedTerminal"
      }
   ]
}